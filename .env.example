# 사이트 기본 URL (canonical, Open Graph, sitemap.xml 에 사용)
NEXT_PUBLIC_SITE_URL=https://www.example.com

# 문의 폼 동작 모드 (서버 API 연결 전)
#   preview  : 제출 시 "미리보기" 완료 화면만 표시. 실제로 접수·저장되지 않음
#   disabled : 제출 버튼 비활성화, 온라인 접수 준비 중 안내
# 미설정 시 개발 환경(next dev)은 preview, 운영 빌드는 disabled
NEXT_PUBLIC_INQUIRY_MODE=

# ── 아래 값은 백엔드(문의 저장·이메일 알림·관리자 인증) 구현 시 사용 예정. 현재 코드에서는 읽지 않음 ──
# DATABASE_URL=mysql://user:password@host:3306/dhcns
# RESEND_API_KEY=
# EMAIL_FROM=
# INQUIRY_NOTIFICATION_EMAIL=
